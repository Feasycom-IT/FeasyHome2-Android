<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">


    <LinearLayout
        android:id="@+id/line_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <View
            android:id="@+id/view_status"
            android:layout_width="match_parent"
            android:layout_height="30dp" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">


            <RelativeLayout
                android:id="@+id/rela_back"
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@mipmap/icon_back" />

            </RelativeLayout>


            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />


        </RelativeLayout>


    </LinearLayout>


    <RelativeLayout
        android:id="@+id/rela_room"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@+id/line_title"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/shap_white_ss5dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="20dp"
            android:text="@string/roommanagement"
            android:textColor="@color/black"
            android:textSize="17sp" />


        <TextView
            android:id="@+id/txt_room_nub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="40dp"
            android:text="@string/room"
            android:textColor="@color/txt_none"
            android:textSize="17sp" />


        <ImageView
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="20dp"
            android:background="@mipmap/icon_more" />


    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rela_member"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@+id/rela_room"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/shap_white_ss5dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="20dp"
            android:text="@string/membermanagement"
            android:textColor="@color/black"
            android:textSize="17sp" />


        <TextView
            android:id="@+id/member_nub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="40dp"
            android:text="@string/member"
            android:textColor="@color/txt_none"
            android:textSize="17sp" />


        <ImageView
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="20dp"
            android:background="@mipmap/icon_more" />


    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rela_disband"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@+id/rela_member"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/shap_white_ss5dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="20dp"
            android:text="@string/dissolvetheentirenetwork"
            android:textColor="@color/black"
            android:textSize="17sp" />


        <ImageView
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="20dp"
            android:background="@mipmap/icon_more" />


    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_del"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:background="@drawable/shap_white_ss5dp"
            android:gravity="center"
            android:text="@string/deletefamily"
            android:textColor="@color/red"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txt_edit"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:background="@drawable/shap_white_ss5dp"
            android:gravity="center"
            android:text="@string/familynaming"
            android:textColor="@color/black"
            android:textSize="17sp" />


    </LinearLayout>


</RelativeLayout>