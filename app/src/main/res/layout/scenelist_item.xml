<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rela_bg"
    android:layout_width="match_parent"
    android:elevation="1dp"
    android:layout_height="100dp">

    <ImageView
        android:id="@+id/img_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />


    <TextView
        android:id="@+id/txt_scene_name"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/shap_black_bottom_circular"
        android:gravity="center"
        android:text="@string/closeall"
        android:textColor="@color/white"
        android:textSize="14sp" />


    <RelativeLayout
        android:id="@+id/rela_edit"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentRight="true">

        <ImageView
            android:id="@+id/img_scene_edit"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_centerInParent="true"
            android:background="@mipmap/scene_icon_more" />

    </RelativeLayout>


</RelativeLayout>