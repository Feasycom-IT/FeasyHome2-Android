<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="15dp"
    android:layout_marginRight="1dp"
    android:background="@drawable/shap_white_ss5dp">


    <RelativeLayout
        android:id="@+id/rela_del"
        android:layout_width="54dp"
        android:layout_centerVertical="true"
        android:layout_height="54dp">

        <ImageView

            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerInParent="true"
            android:background="@mipmap/family_icon_delete" />

    </RelativeLayout>


    <TextView
        android:id="@+id/txt_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/rela_del"
        android:textColor="@color/black"
        android:textSize="17sp" />


    <TextView
        android:id="@+id/txt_dev_nub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="15dp"
        android:layout_toRightOf="@+id/txt_name"
        android:text="@string/devices"
        android:textColor="@color/txt_none"
        android:textSize="17sp" />


    <RelativeLayout
        android:id="@+id/rela_edit"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentRight="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerInParent="true"
            android:background="@mipmap/family_icon_edits" />

    </RelativeLayout>


</RelativeLayout>